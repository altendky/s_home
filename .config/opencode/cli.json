{
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "command.palette.show": "ctrl+o",
    "session.rename": "ctrl+r",
    "session.parent": "<leader>up",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.page.up": "pageup",
    "session.page.down": "pagedown",
    "session.first": "ctrl+g,home",
    "session.messages_last_user": "none",
    "prompt.paste": "ctrl+v",
    "input.newline": "shift+return,ctrl+return,alt+return,ctrl+j",
    "input.buffer.home": "home",
    "input.buffer.end": "end"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "tabs": {
    "enabled": false
  },
  "animations": false
}
