{
  "tools": {
    "bash": true,
    "question": true
  },
  "mcp": {
    "orchestrator": {
      "environment": {
        "OPENCODE_DB": "opencode-orchestrator.db"
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/data/tmp/*": "allow",
      "~/.cargo/registry/src/*": "allow"
    },
    "edit": {
      "*": "ask",
      "/data/tmp/*": "allow",
      "~/.cargo/registry/src/*": "deny"
    }
  },
  "agent": {
    "Normal": {
      "permission": {
        "execute": "allow"
      }
    },
    "Orchestrator": {
      "permission": {
        "execute": "allow"
      }
    },
    "Review": {
      "permission": {
        "execute": "allow"
      }
    },
    "Devtools": {
      "permission": {
        "execute": "allow"
      }
    },
    "Linear": {
      "permission": {
        "execute": "allow"
      }
    },
    "Discord": {
      "permission": {
        "execute": "allow"
      }
    },
    "Grafana": {
      "permission": {
        "execute": "allow"
      }
    },
    "Sentry": {
      "permission": {
        "execute": "allow"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
